# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Environment / secrets
.env
.env.*
*.key

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated
.DS_Store
Thumbs.db

# Images (allow docs/ images for README)
*.png
*.jpg
*.JPG
!docs/*
# Captured scene images ARE tracked -- rgb.png is the pipeline's input,
# annotated.jpg is the GroundedSAM detection overlay.
!extracted/**/*.png
!extracted/**/*.jpg

# Model weights
*.pth
*.pt
*.tar

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Logs and data (keep directory structure via .gitkeep)
pragmabot/data/logs/*
!pragmabot/data/logs/.gitkeep

pragmabot/data/ltm/*
!pragmabot/data/ltm/ltm.csv

# Scripts output (keep directory structure via .gitkeep)
scripts/output/*
!scripts/output/.gitkeep

# Log files
*.log

# FR3 host-adaptation workspace: rosbags, extracted frames, model checkpoints
# Raw rosbags: 832 MB, over GitHub's 100 MB/file limit -> transferred manually.
bags/*
!bags/.gitkeep
!bags/extract_bag.py
!bags/*/metadata.yaml

# extracted/ IS tracked (13 MB): lets a teammate run the perception -> grasp
# pipeline offline without needing the rosbag.

# Model weights: fetched by setup.sh from official sources.
weights/*
!weights/.gitkeep
