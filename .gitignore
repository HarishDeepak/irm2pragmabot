# ---- venvs: compiled per-GPU, never portable ----
.venv/
**/.venv/
.venv_py39_unused/

# ---- colcon build output ----
build/
install/
log/

# ---- model weights: fetched by setup.sh from official sources ----
*.pth
*.pt
*.ckpt
*.safetensors
# checkpoints: weights are excluded by the *.pth/*.pt rules above, but the
# small YAML gripper configs in GraspGenModels/checkpoints/ ARE tracked.
**/gdino_checkpoints/*.pth
weights/

# ---- recorded data ----
# Only the raw rosbag is excluded: 832 MB, over GitHub's 100 MB/file limit.
# Transferred manually -> place at pragmabot/bags/red_cup/red_cup_0.db3
*.db3

# extracted/ (13 MB) IS tracked on purpose: it lets a teammate run the
# perception -> grasp pipeline offline immediately, without the rosbag.

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
*.so

# ---- secrets ----
.env
.env~
*.key

# ---- os / editor ----
.DS_Store
Thumbs.db
*.swp
