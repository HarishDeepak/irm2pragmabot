# Copy to .env before running docker compose:
#     cd ros2_ws/franka_ros2 && cp .env.example .env && \
#     sed -i "s/^USER_UID=.*/USER_UID=$(id -u)/; s/^USER_GID=.*/USER_GID=$(id -g)/" .env
#
# These must match YOUR user, or files created inside the container are
# owned by the wrong uid on the host.
USER_UID=1000
USER_GID=1000
