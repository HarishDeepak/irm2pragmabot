# Normalise line endings so shell scripts run on Windows checkouts.
# Without this, git on Windows converts *.sh to CRLF and bash fails with
#   setup.sh: line 7: $'\r': command not found
* text=auto

# Must always be LF -- executed by bash/python regardless of host OS
*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.xml     text eol=lf
*.launch  text eol=lf
*.srv     text eol=lf
*.msg     text eol=lf
*.action  text eol=lf
*.cfg     text eol=lf
*.rviz    text eol=lf
Dockerfile* text eol=lf
Makefile  text eol=lf

# Windows-only scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary -- never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.npy binary
*.npz binary
*.db3 binary
*.pth binary
*.pt  binary
*.so  binary
*.stl binary
*.dae binary
*.obj binary
*.STL binary
